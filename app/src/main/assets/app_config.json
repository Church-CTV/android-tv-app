{
  "version": "1.0.0",
  "channel": {
    "name": "Example Channel",
    "description": "Example channel",
    "language": "en",
    "copyright": "Copyright 2026"
  },
  "branding": {
    "colors": {
      "background": "#1A1A2E",
      "surface": "#16213E",
      "accent": "#E8B931",
      "textPrimary": "#FFFFFF",
      "textSecondary": "#A0A0B0",
      "focus": "#E8B931",
      "navFocusBg": "#E8B931",
      "error": "#FF4444",
      "live": "#FF0000",
      "success": "#4CAF50"
    },
    "images": {
      "overhangLogo": "",
      "backgroundImage": "",
      "iconFocus": "",
      "liveStreamUrl": "",
      "liveStreamThumbnail": ""
    },
    "fonts": {
      "title": "font:BoldSystemFont",
      "body": "font:MediumSystemFont",
      "caption": "font:SmallSystemFont",
      "heading": "font:ExtraBoldSystemFont"
    },
    "spacing": {
      "marginHorizontal": 80,
      "marginVertical": 40
    },
    "animation": {
      "cardScale": 1.05,
      "transitionDuration": 0.25
    }
  },
  "content": {
    "sourceUrl": "https://example.invalid/feed",
    "userAgent": "FireTV/1.0",
    "maxRows": 20,
    "maxItemsPerRow": 12,
    "retryAttempts": 3,
    "retryDelayMs": 2000,
    "fetchTimeout": 30,
    "sslCertificates": "common:/certs/ca-bundle.crt"
  },
  "features": {
    "layoutPreference": "leftnav",
    "search": true,
    "deepLinking": false,
    "analytics": false,
    "crashReporting": false,
    "overhangLogo": true,
    "overhangClock": true,
    "overhangOptions": true,
    "continueWatching": true,
    "liveService": false
  },
  "navItems": [
    {
      "id": "home",
      "label": "Home",
      "icon": "Home",
      "page": "home",
      "visible": true,
      "order": 0
    },
    {
      "id": "search",
      "label": "Search",
      "icon": "Search",
      "page": "search",
      "visible": true,
      "order": 1
    },
    {
      "id": "settings",
      "label": "Settings",
      "icon": "Settings",
      "page": "settings",
      "visible": true,
      "order": 2
    }
  ],
  "pageRegistry": {
    "home": {
      "component": "GridScreen",
      "title": "Home",
      "requiresAuth": false
    },
    "continue": {
      "component": "ContinueWatchingScreen",
      "title": "Continue Watching",
      "requiresAuth": false
    }
  },
  "ui": {
    "backgroundColor": "#1A1A2E",
    "welcome": {
      "enabled": true,
      "title": "Loading...",
      "subtitle": "Please wait"
    },
    "error": {
      "title": "Connection Error",
      "message": "Unable to load content. Please check your network connection and try again.",
      "retryLabel": "Retry"
    },
    "loading": {
      "message": "Loading..."
    }
  },
  "analytics": {
    "enabled": false,
    "exportUrl": "",
    "exportIntervalSeconds": 300,
    "maxEventsPerBatch": 50,
    "flushOnError": true
  },
  "giving": {
    "donationUrl": ""
  },
  "cardStyle": {
    "showTitle": false,
    "showDescription": false,
    "titleFont": "font:SmallSystemFont",
    "descriptionFont": "font:SmallSystemFont",
    "titleColor": "#FFFFFF",
    "descriptionColor": "#A0A0B0",
    "titleNumLines": 2,
    "descriptionNumLines": 1,
    "showDetailTitle": false,
    "showDetailDescription": false,
    "detailTitleFont": "font:SmallBoldSystemFont",
    "detailDescriptionFont": "font:SmallSystemFont",
    "detailTitleColor": "#FFFFFF",
    "detailDescriptionColor": "#A0A0B0",
    "detailTitleNumLines": 1,
    "detailDescriptionNumLines": 3
  },
  "heartbeat": {
    "intervalSeconds": 60,
    "exportUrl": ""
  },
  "server": {
    "baseUrl": "https://example.invalid",
    "timeout": 15
  }
}
